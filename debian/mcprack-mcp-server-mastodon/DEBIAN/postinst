#!/bin/sh
set -e

case "$1" in
  configure)
    if getent passwd mcprack >/dev/null 2>&1 && [ -d /usr/lib/mcprack ]; then
      su -s /bin/sh mcprack -c "cd /usr/lib/mcprack && set -a; . /etc/mcprack/env; set +a; \
        mcprack server create mcp-server-mastodon \
          --label 'Mastodon MCP Server' \
          --transport stdio \
          --command /usr/bin/mastodon-mcp \
          --category debian \
          --enabled" || true
    fi
    ;;
esac



exit 0
